rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Bootstrapped Admin + Trusted Admin Collection Lookup
    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'recipeskristen@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function hasValidParentUser(userId) {
      return (
        exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.uid == userId
      ) || (
        existsAfter(/databases/$(database)/documents/users/$(userId)) &&
        getAfter(/databases/$(database)/documents/users/$(userId)).data.uid == userId
      );
    }

    // 3. Validation Blueprints (Anti-Update-Gap)
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'photoURL',
        'plan',
        'targetLevel',
        'goal',
        'city',
        'completedDaysCount',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'displayName',
        'photoURL',
        'plan',
        'status',
        'targetLevel',
        'goal',
        'city',
        'currentDay',
        'currentLesson',
        'currentPage',
        'completedDaysCount',
        'speakingHistoryCount',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string &&
      data.uid.size() >= 1 &&
      data.uid.size() <= 128 &&
      data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.uid == userId &&
      data.displayName is string &&
      data.displayName.size() >= 1 &&
      data.displayName.size() <= 100 &&
      data.photoURL is string &&
      data.photoURL.size() <= 500 &&
      data.plan is string &&
      data.plan.size() <= 32 &&
      data.plan in ['free', 'goethe_pass', 'ausbildung_pro'] &&
      (!('status' in data) || (data.status is string && data.status.size() <= 20 && data.status in ['active', 'suspended'])) &&
      data.targetLevel is string &&
      data.targetLevel.size() <= 10 &&
      data.targetLevel in ['A1', 'A2', 'B1'] &&
      data.goal is string &&
      data.goal.size() >= 1 &&
      data.goal.size() <= 100 &&
      data.city is string &&
      data.city.size() >= 1 &&
      data.city.size() <= 80 &&
      (!('currentDay' in data) || (data.currentDay is int && data.currentDay >= 1 && data.currentDay <= 30)) &&
      (!('currentLesson' in data) || (data.currentLesson is int && data.currentLesson >= 1 && data.currentLesson <= 30)) &&
      (!('currentPage' in data) || (data.currentPage is int && data.currentPage >= 1 && data.currentPage <= 250)) &&
      data.completedDaysCount is int &&
      data.completedDaysCount >= 0 &&
      data.completedDaysCount <= 30 &&
      (!('speakingHistoryCount' in data) || (data.speakingHistoryCount is int && data.speakingHistoryCount >= 0 && data.speakingHistoryCount <= 100000)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
      data.uid is string &&
      data.uid.size() >= 1 &&
      data.uid.size() <= 128 &&
      data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.uid == userId &&
      data.email is string &&
      data.email.size() >= 3 &&
      data.email.size() <= 254 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCourseProgressDoc(data, userId) {
      return data.keys().hasAll([
        'uid',
        'bookId',
        'currentLesson',
        'currentDay',
        'currentPage',
        'completedDays',
        'completedPages',
        'speakingHistoryCount',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'bookId',
        'currentLesson',
        'currentDay',
        'currentPage',
        'completedDays',
        'completedPages',
        'speakingHistoryCount',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string &&
      data.uid.size() >= 1 &&
      data.uid.size() <= 128 &&
      data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.uid == userId &&
      data.bookId is string &&
      data.bookId.size() >= 1 &&
      data.bookId.size() <= 128 &&
      data.bookId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.currentLesson is int &&
      data.currentLesson >= 1 &&
      data.currentLesson <= 30 &&
      data.currentDay is int &&
      data.currentDay >= 1 &&
      data.currentDay <= 30 &&
      data.currentPage is int &&
      data.currentPage >= 1 &&
      data.currentPage <= 250 &&
      data.completedDays is list &&
      data.completedDays.size() <= 30 &&
      (data.completedDays.size() == 0 || data.completedDays[0] is int) &&
      data.completedPages is list &&
      data.completedPages.size() <= 100 &&
      (data.completedPages.size() == 0 || data.completedPages[0] is int) &&
      data.speakingHistoryCount is int &&
      data.speakingHistoryCount >= 0 &&
      data.speakingHistoryCount <= 100000 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPlatformSettings(data) {
      return data.keys().hasAll([
        'freeModeEnabled',
        'symbolicPriceMad',
        'proPriceMad',
        'announcementText',
        'allowNewSignups',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'freeModeEnabled',
        'symbolicPriceMad',
        'proPriceMad',
        'announcementText',
        'allowNewSignups',
        'updatedAt'
      ]) &&
      data.freeModeEnabled is bool &&
      data.symbolicPriceMad is int &&
      data.symbolicPriceMad >= 0 &&
      data.symbolicPriceMad <= 10000 &&
      data.proPriceMad is int &&
      data.proPriceMad >= 0 &&
      data.proPriceMad <= 20000 &&
      data.announcementText is string &&
      data.announcementText.size() <= 250 &&
      data.allowNewSignups is bool &&
      data.updatedAt is timestamp;
    }

    // 4. Collection: /settings/{settingId} (Global Platform Settings)
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'platform';
      allow list: if false;

      allow create: if isAdmin() &&
        isValidId(settingId) &&
        settingId == 'platform' &&
        isValidPlatformSettings(incoming()) &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidPlatformSettings(incoming()) &&
        isValidId(settingId) &&
        settingId == 'platform' &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'freeModeEnabled',
          'symbolicPriceMad',
          'proPriceMad',
          'announcementText',
          'allowNewSignups',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    // 5. Collection: /users/{userId}
    match /users/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      // Secure List Query: Only Admin can list user profiles, and resource.data.uid must be a valid string
      allow list: if isAdmin() && resource.data.uid is string && resource.data.uid.size() <= 128;

      allow create: if isVerifiedUser() &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        (!('status' in incoming()) || incoming().status == 'active') &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidUserProfile(incoming(), userId) &&
        isValidId(userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Admin Override (Manage plan, active/suspended status, or progress)
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'photoURL',
              'plan',
              'status',
              'targetLevel',
              'goal',
              'city',
              'currentDay',
              'currentLesson',
              'currentPage',
              'completedDaysCount',
              'speakingHistoryCount',
              'updatedAt'
            ])
          ) ||
          // Action 2: Owner Update (Cannot self-unsuspend if suspended by Admin)
          (
            isOwner(userId) &&
            (!('status' in existing()) || existing().status == 'active') &&
            (!('status' in incoming()) || incoming().status == 'active') &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'photoURL',
              'plan',
              'status',
              'targetLevel',
              'goal',
              'city',
              'currentDay',
              'currentLesson',
              'currentPage',
              'completedDaysCount',
              'speakingHistoryCount',
              'updatedAt'
            ])
          )
        );

      allow delete: if false;

      // 6. Subcollection: /users/{userId}/private/{docId} (PII Isolation)
      match /private/{docId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(docId) && hasValidParentUser(userId);
        allow list: if false;

        allow create: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasValidParentUser(userId);

        allow update: if isVerifiedUser() &&
          isValidUserPrivateInfo(incoming(), userId) &&
          (isOwner(userId) || isAdmin()) &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']) &&
          hasValidParentUser(userId);

        allow delete: if false;
      }

      // 7. Subcollection: /users/{userId}/progress/{bookId} (Cloud Course Progress)
      match /progress/{bookId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(bookId) && hasValidParentUser(userId);
        allow list: if false;

        allow create: if isVerifiedUser() &&
          (isOwner(userId) || isAdmin()) &&
          isValidId(userId) &&
          isValidId(bookId) &&
          isValidCourseProgressDoc(incoming(), userId) &&
          incoming().bookId == bookId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasValidParentUser(userId);

        allow update: if isVerifiedUser() &&
          isValidCourseProgressDoc(incoming(), userId) &&
          (isOwner(userId) || isAdmin()) &&
          isValidId(userId) &&
          isValidId(bookId) &&
          incoming().uid == existing().uid &&
          incoming().bookId == existing().bookId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'currentLesson',
            'currentDay',
            'currentPage',
            'completedDays',
            'completedPages',
            'speakingHistoryCount',
            'updatedAt'
          ]) &&
          hasValidParentUser(userId);

        allow delete: if false;
      }
    }
  }
}
